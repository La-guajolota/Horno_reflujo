/**
 * @brief Reads temperature from MAX6675_MAX_DEVICES sensors and calculates chamber average temperature
 * @note Updates global variable chamber_temp with averaged result
 */
void chamber_sense_temperature(void)
{
	float sum = 0.0f;
    uint8_t valid_sensor_count = 0;

    for (int sensor = 0; sensor < MAX6675_MAX_DEVICES; sensor++) {
    	if (MAX6675_ReadTemperature(&tempSensors, sensor) != HAL_OK) continue;
    	if (MAX6675_GetTemperature(&tempSensors, sensor, tempReadings + sensor) != HAL_OK) continue;
		sum += tempReadings[sensor];
		valid_sensor_count++;
    }

    if (valid_sensor_count) {
    	chamber_temp = (sum / valid_sensor_count) - 5.0f; // Compensate for sensor/system bias
	}
//    else {
//	    chamber_temp = MAX6675_INVALID_TEMP;
//	}
}

/**
 * @brief Formats float data with wrapper characters and transmits via UART DMA
 * @param data Float value to format and transmit
 * @param wrapper Character to wrap around the formatted number
 */
